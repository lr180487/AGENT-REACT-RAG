# .env — agente_react_rag 3.0 | PERCEPCIÓN → RAZONAMIENTO → MEMORIA → ACCIÓN
# Sincronizado con dashboard, interfaz, nuevo-chat + WS /ws/langchain
# PostgreSQL con fallback SQLite + ReAct limits + Cache L1/L2

# ── App ──
APP_NAME=agente_react_rag
VERSION=3.0.0
ENV=development
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# ── FastAPI / Seguridad ──
SECRET_KEY=dev-secret-change-in-production-32chars!
ENCRYPTION_KEY=32bytes-key-for-aes-256-gcm-!!!!

# ── Database: PostgreSQL primario con fallback SQLite ──
# - Si DATABASE_URL es válido y conecta, usa PostgreSQL + pgvector
# - Si falla, placeholder o driver ausente → fallback automático a sqlite:////home/user/agente_react_rag/app/data/app.db
# - En producción: establece DATABASE_URL real, p.ej. postgresql://postgres:postgres@postgres:5432/react_rag
DATABASE_URL=postgresql://user:pass@localhost:5432/react_rag
DATABASE_FALLBACK=sqlite
# SQLITE_PATH vacío = app/data/app.db (recomendado). Para custom: /ruta/a/mi.db
SQLITE_PATH=
# Alternativas Docker / Upstash:
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/react_rag
# DATABASE_URL=postgresql://user:pass@db:5432/react_rag

# ── Redis / Upstash (L2) ──
REDIS_URL=redis://localhost:6379/0
# Para Upstash (memoria distribuida memoria.md §5):
# UPSTASH_REDIS_URL=https://***.upstash.io
# UPSTASH_REDIS_TOKEN=AX***
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=
UPSTASH_ENABLED=false

# ── LLM Fallback (.env) — si no hay config en DB llm_configs ──
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_MS=15000

# Keys por proveedor (fallback si no se usa POST /api/v1/llm/config)
OPENAI_API_KEY=sk-mock-dev-key-reemplaza-en-produccion
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ── RAG / Embeddings / pgvector ──
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
CHUNK_SIZE=800
CHUNK_OVERLAP=120
PGVECTOR_DIM=1536

# ── Web Search ──
TAVILY_API_KEY=
SERPAPI_API_KEY=
WEB_SEARCH_PROVIDER=tavily
# Primario Tavily, fallback DuckDuckGo (Python) automático

# ── ReAct — Control del razonamiento (razonamiento.md §8) ──
MAX_ITERATIONS=8
MAX_TOOL_CALLS=10
TOOL_TIMEOUT=15
TOKEN_LIMIT=8000
REACT_TIMEOUT=45

# ── Memoria — TTLs (memoria.md §9) ──
LRU_MAX_SIZE=512
LRU_TTL_SECONDS=300
UPSTASH_TTL_SECONDS=1800
SESSION_TTL_SECONDS=3600
CACHE_ENABLED=true

# ── Acción — Controles (accion.md §7-11) ──
HUMAN_IN_THE_LOOP=false
IDEMPOTENCY_ENABLED=true
CIRCUIT_BREAKER_ENABLED=true
RATE_LIMIT_RPS=10

# ── Frontend / CORS / WebSocket ──
FRONTEND_URL=http://localhost:8000/frontend
CORS_ORIGINS=*
WS_LANGCHAIN_PATH=/ws/langchain
WS_HEARTBEAT_INTERVAL=2

# ── Uploads ──
MAX_UPLOAD_MB=20
ALLOWED_EXTENSIONS=pdf,docx,doc,xlsx,xls,ppt,pptx,csv,txt,md,png,jpg,jpeg
